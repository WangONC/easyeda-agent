{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device Knowledge V0.1 entry",
  "description": "Static device facts only. Cross-reference, index and archive checks are implemented by scripts/check-device-knowledge.py using the standard library. No design schema.",
  "type": "object",
  "required": [
    "id",
    "manufacturer",
    "mpn",
    "lcsc",
    "schema_version",
    "category",
    "availability",
    "provenance",
    "sources",
    "facts",
    "pins",
    "constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "mpn": {
      "type": "string",
      "minLength": 1
    },
    "lcsc": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "0.1"
    },
    "category": {
      "enum": [
        "LDO",
        "DC-DC",
        "MCU",
        "Battery Management",
        "MOSFET"
      ]
    },
    "availability": {
      "const": "scoped_facts"
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "archive_sha256",
            "member",
            "identity_status",
            "original_datasheet_url"
          ],
          "additionalProperties": false,
          "properties": {
            "archive_sha256": {
              "type": "string",
              "minLength": 1
            },
            "member": {
              "type": "string",
              "minLength": 1
            },
            "identity_status": {
              "type": "string",
              "minLength": 1
            },
            "original_datasheet_url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "identity_status",
            "original_datasheet_url",
            "identity_url",
            "replaces"
          ],
          "additionalProperties": false,
          "properties": {
            "identity_status": {
              "type": "string",
              "minLength": 1
            },
            "original_datasheet_url": {
              "type": "string",
              "minLength": 1
            },
            "identity_url": {
              "type": "string",
              "minLength": 1
            },
            "replaces": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "url",
          "document",
          "pdf_page"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "document": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "printed_page": {
            "type": [
              "integer",
              "string"
            ]
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "figure": {
            "type": "string",
            "minLength": 1
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minProperties": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "values",
          "source_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "object",
            "minProperties": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "values",
          "source_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "object",
            "minProperties": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "values",
          "source_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "object",
            "minProperties": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reference_applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "conditions",
          "scope",
          "source_refs",
          "netlist",
          "coverage"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "object"
          },
          "scope": {
            "enum": [
              "topology_only",
              "documented_example"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "netlist": {
            "type": "object",
            "required": [
              "components",
              "nets"
            ],
            "additionalProperties": false,
            "properties": {
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ]
                }
              },
              "nets": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
